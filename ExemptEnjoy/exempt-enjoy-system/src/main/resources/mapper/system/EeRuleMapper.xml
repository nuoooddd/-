<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exemptenjoy.system.mapper.EeRuleMapper">
    <resultMap type="EeRule" id="EeRuleResult">
        <result property="ruleId" column="rule_id" />
        <result property="policyId" column="policy_id" />
        <result property="ruleName" column="rule_name" />
        <result property="conditionExpr" column="condition_expr" />
        <result property="pdfUrl" column="pdf_url" />
        <result property="pdfName" column="pdf_name" />
        <result property="status" column="status" />
        <result property="remark" column="remark" />
        <result property="policyName" column="policy_name" />
    </resultMap>
    <select id="selectEeRuleList" parameterType="EeRule" resultMap="EeRuleResult">
        select r.rule_id, r.policy_id, r.rule_name, r.condition_expr, p.pdf_url, p.pdf_name, r.status, r.remark,
               p.policy_name as policy_name
        from ee_rule r
        left join ee_policy p on r.policy_id = p.policy_id
        <where>
            <if test="ruleId != null"> and r.rule_id = #{ruleId}</if>
            <if test="policyId != null"> and r.policy_id = #{policyId}</if>
            <if test="ruleName != null and ruleName != ''"> and r.rule_name like concat('%', #{ruleName}, '%')</if>
            <if test="status != null and status != ''"> and r.status = #{status}</if>
        </where>
        order by r.rule_id desc
    </select>
    
    <select id="selectEeRuleByRuleId" parameterType="Long" resultMap="EeRuleResult">
        select r.rule_id, r.policy_id, r.rule_name, r.condition_expr, p.pdf_url, p.pdf_name, r.status, r.remark,
               p.policy_name as policy_name
        from ee_rule r
        left join ee_policy p on r.policy_id = p.policy_id
        where r.rule_id = #{ruleId}
    </select>
    
    <insert id="insertEeRule" parameterType="EeRule" useGeneratedKeys="true" keyProperty="ruleId">
        insert into ee_rule
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="policyId != null">policy_id,</if>
            <if test="ruleName != null and ruleName != ''">rule_name,</if>
            <if test="conditionExpr != null and conditionExpr != ''">condition_expr,</if>
            <if test="pdfUrl != null and pdfUrl != ''">pdf_url,</if>
            <if test="pdfName != null and pdfName != ''">pdf_name,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="policyId != null">#{policyId},</if>
            <if test="ruleName != null and ruleName != ''">#{ruleName},</if>
            <if test="conditionExpr != null and conditionExpr != ''">#{conditionExpr},</if>
            <if test="pdfUrl != null and pdfUrl != ''">#{pdfUrl},</if>
            <if test="pdfName != null and pdfName != ''">#{pdfName},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
        </trim>
    </insert>
    
    <update id="updateEeRule" parameterType="EeRule">
        update ee_rule
        <trim prefix="SET" suffixOverrides=",">
            <if test="policyId != null">policy_id = #{policyId},</if>
            <if test="ruleName != null and ruleName != ''">rule_name = #{ruleName},</if>
            <if test="conditionExpr != null and conditionExpr != ''">condition_expr = #{conditionExpr},</if>
            pdf_url = #{pdfUrl},
            pdf_name = #{pdfName},
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
        </trim>
        where rule_id = #{ruleId}
    </update>
    
    <update id="updateEeRuleStatusByPolicyId">
        update ee_rule set status = #{status} where policy_id = #{policyId}
    </update>

    <delete id="deleteEeRuleByRuleIds" parameterType="String">
        delete from ee_rule where rule_id in 
        <foreach item="ruleId" collection="array" open="(" separator="," close=")">
            #{ruleId}
        </foreach>
    </delete>
</mapper>
