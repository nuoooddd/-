<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exemptenjoy.system.mapper.EeTargetDataMapper">
    <resultMap type="EeTargetData" id="EeTargetDataResult">
        <result property="targetId" column="target_id" />
        <result property="targetName" column="target_name" />
        <result property="targetType" column="target_type" />
        <result property="identifier" column="identifier" />
        <result property="attributes" column="attributes" />
        <result property="contactPhone" column="contact_phone" />
        <result property="bankAccount" column="bank_account" />
        <result property="status" column="status" />
        <result property="userId" column="user_id" />
    </resultMap>
    
    <sql id="selectEeTargetDataVo">
        select target_id, target_name, target_type, identifier, attributes, contact_phone, bank_account, status, user_id from ee_target_data
    </sql>
    
    <select id="selectEeTargetDataList" parameterType="EeTargetData" resultMap="EeTargetDataResult">
        <include refid="selectEeTargetDataVo"/>
        <where>
            <if test="targetId != null"> and target_id = #{targetId}</if>
            <if test="targetName != null and targetName != ''"> and target_name like concat('%', #{targetName}, '%')</if>
            <if test="targetType != null and targetType != ''"> and target_type = #{targetType}</if>
            <if test="identifier != null and identifier != ''"> and identifier = #{identifier}</if>
            <if test="contactPhone != null and contactPhone != ''"> and contact_phone = #{contactPhone}</if>
            <if test="bankAccount != null and bankAccount != ''"> and bank_account = #{bankAccount}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectEeTargetDataByTargetId" parameterType="Long" resultMap="EeTargetDataResult">
        <include refid="selectEeTargetDataVo"/>
        where target_id = #{targetId}
    </select>
    
    <insert id="insertEeTargetData" parameterType="EeTargetData" useGeneratedKeys="true" keyProperty="targetId">
        insert into ee_target_data
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="targetName != null and targetName != ''">target_name,</if>
            <if test="targetType != null and targetType != ''">target_type,</if>
            <if test="identifier != null and identifier != ''">identifier,</if>
            <if test="attributes != null and attributes != ''">attributes,</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone,</if>
            <if test="bankAccount != null and bankAccount != ''">bank_account,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="userId != null">user_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="targetName != null and targetName != ''">#{targetName},</if>
            <if test="targetType != null and targetType != ''">#{targetType},</if>
            <if test="identifier != null and identifier != ''">#{identifier},</if>
            <if test="attributes != null and attributes != ''">#{attributes},</if>
            <if test="contactPhone != null and contactPhone != ''">#{contactPhone},</if>
            <if test="bankAccount != null and bankAccount != ''">#{bankAccount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="userId != null">#{userId},</if>
        </trim>
    </insert>
    
    <update id="updateEeTargetData" parameterType="EeTargetData">
        update ee_target_data
        <trim prefix="SET" suffixOverrides=",">
            <if test="targetName != null and targetName != ''">target_name = #{targetName},</if>
            <if test="targetType != null and targetType != ''">target_type = #{targetType},</if>
            <if test="identifier != null and identifier != ''">identifier = #{identifier},</if>
            <if test="attributes != null and attributes != ''">attributes = #{attributes},</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone = #{contactPhone},</if>
            <if test="bankAccount != null and bankAccount != ''">bank_account = #{bankAccount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
        </trim>
        where target_id = #{targetId}
    </update>
    
    <delete id="deleteEeTargetDataByTargetIds" parameterType="String">
        delete from ee_target_data where target_id in 
        <foreach item="targetId" collection="array" open="(" separator="," close=")">
            #{targetId}
        </foreach>
    </delete>

    <select id="selectEeTargetDataByUserId" parameterType="Long" resultMap="EeTargetDataResult">
        <include refid="selectEeTargetDataVo"/>
        where user_id = #{userId} and status = '0'
    </select>
</mapper>
