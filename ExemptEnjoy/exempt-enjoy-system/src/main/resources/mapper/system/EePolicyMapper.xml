<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exemptenjoy.system.mapper.EePolicyMapper">
    <resultMap type="EePolicy" id="EePolicyResult">
        <result property="policyId" column="policy_id" />
        <result property="policyName" column="policy_name" />
        <result property="policyType" column="policy_type" />
        <result property="amount" column="amount" />
        <result property="publishDept" column="publish_dept" />
        <result property="status" column="status" />
        <result property="remark" column="remark" />
        <result property="startDate" column="start_date" />
        <result property="endDate" column="end_date" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="pdfUrl" column="pdf_url" />
        <result property="pdfName" column="pdf_name" />
    </resultMap>
    <sql id="selectEePolicyVo">
        select policy_id, policy_name, policy_type, amount, publish_dept, status, remark, start_date, end_date, create_by, create_time, update_by, update_time, pdf_url, pdf_name from ee_policy
    </sql>
    <select id="selectEePolicyList" parameterType="EePolicy" resultMap="EePolicyResult">
        <include refid="selectEePolicyVo"/>
        <where>
            <if test="policyId != null"> and policy_id = #{policyId}</if>
            <if test="policyName != null and policyName != ''"> and policy_name like concat('%', #{policyName}, '%')</if>
            <if test="policyType != null and policyType != ''"> and policy_type = #{policyType}</if>
            <if test="amount != null"> and amount = #{amount}</if>
            <if test="publishDept != null and publishDept != ''"> and publish_dept like concat('%', #{publishDept}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by policy_id
    </select>
    
    <select id="selectEePolicyByPolicyId" parameterType="Long" resultMap="EePolicyResult">
        <include refid="selectEePolicyVo"/>
        where policy_id = #{policyId}
    </select>
    
    <insert id="insertEePolicy" parameterType="EePolicy" useGeneratedKeys="true" keyProperty="policyId">
        insert into ee_policy
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="policyName != null and policyName != ''">policy_name,</if>
            <if test="policyType != null and policyType != ''">policy_type,</if>
            <if test="amount != null">amount,</if>
            <if test="publishDept != null and publishDept != ''">publish_dept,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="pdfUrl != null and pdfUrl != ''">pdf_url,</if>
            <if test="pdfName != null and pdfName != ''">pdf_name,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="policyName != null and policyName != ''">#{policyName},</if>
            <if test="policyType != null and policyType != ''">#{policyType},</if>
            <if test="amount != null">#{amount},</if>
            <if test="publishDept != null and publishDept != ''">#{publishDept},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="pdfUrl != null and pdfUrl != ''">#{pdfUrl},</if>
            <if test="pdfName != null and pdfName != ''">#{pdfName},</if>
        </trim>
    </insert>
    
    <update id="updateEePolicy" parameterType="EePolicy">
        update ee_policy
        <trim prefix="SET" suffixOverrides=",">
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="policyName != null and policyName != ''">policy_name = #{policyName},</if>
            <if test="policyType != null and policyType != ''">policy_type = #{policyType},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="publishDept != null and publishDept != ''">publish_dept = #{publishDept},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            pdf_url = #{pdfUrl},
            pdf_name = #{pdfName},
        </trim>
        where policy_id = #{policyId}
    </update>
    
    <delete id="deleteEePolicyByPolicyIds" parameterType="String">
        delete from ee_policy where policy_id in 
        <foreach item="policyId" collection="array" open="(" separator="," close=")">
            #{policyId}
        </foreach>
    </delete>
</mapper>
